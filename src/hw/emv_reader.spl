use std.io_runtime

# EMV chip reader — ISO 7816 APDU command sequences.
# Refs: EMV Book 1-4 (contact interface), ISO 7816-4 (APDU structure).

enum ApduClass:
    IsoStandard
    Proprietary

struct ApduCommand:
    val cla: int
    val ins: int
    val p1: int
    val p2: int
    val data: text
    val le: int

struct ApduResponse:
    val sw1: int
    val sw2: int
    val data: text

fn apdu_success(resp: ApduResponse) -> bool:
    return resp.sw1 == 144 and resp.sw2 == 0

fn apdu_status_word(resp: ApduResponse) -> int:
    return resp.sw1 * 256 + resp.sw2

fn select_ppse() -> ApduCommand:
    return ApduCommand { cla: 0, ins: 164, p1: 4, p2: 0, data: "325041592E5359532E4444463031", le: 0 }

fn select_aid(aid: text) -> ApduCommand:
    return ApduCommand { cla: 0, ins: 164, p1: 4, p2: 0, data: aid, le: 0 }

fn get_processing_options(pdol_data: text) -> ApduCommand:
    return ApduCommand { cla: 128, ins: 168, p1: 0, p2: 0, data: pdol_data, le: 0 }

fn read_record(sfi: int, record: int) -> ApduCommand:
    val p2 = sfi * 8 + 4
    return ApduCommand { cla: 0, ins: 178, p1: record, p2: p2, data: "", le: 0 }

fn generate_ac(ac_type: int, data: text) -> ApduCommand:
    return ApduCommand { cla: 128, ins: 174, p1: ac_type, p2: 0, data: data, le: 0 }

fn verify_pin(pin_block: text) -> ApduCommand:
    return ApduCommand { cla: 0, ins: 32, p1: 0, p2: 128, data: pin_block, le: 0 }

enum EmvTransactionType:
    Purchase
    CashAdvance
    Refund

struct EmvTransactionData:
    val amount: int
    val currency_code: int
    val transaction_type: EmvTransactionType
    val terminal_country: int
    val unpredictable_number: int

struct EmvResult:
    val success: bool
    val pan_token: text
    val auth_code: text
    val aid: text
    val app_label: text
    val cryptogram: text
    val error_message: text

fn emv_transaction_flow(txn: EmvTransactionData) -> EmvResult:
    val ppse = select_ppse()
    val ppse_resp = _simulate_apdu(ppse)
    if !apdu_success(ppse_resp):
        return EmvResult { success: false, pan_token: "", auth_code: "", aid: "", app_label: "", cryptogram: "", error_message: "PPSE selection failed" }
    val aid_str = "A0000000041010"
    val select_resp = _simulate_apdu(select_aid(aid_str))
    if !apdu_success(select_resp):
        return EmvResult { success: false, pan_token: "", auth_code: "", aid: aid_str, app_label: "", cryptogram: "", error_message: "AID selection failed" }
    val gpo_resp = _simulate_apdu(get_processing_options(""))
    if !apdu_success(gpo_resp):
        return EmvResult { success: false, pan_token: "", auth_code: "", aid: aid_str, app_label: "", cryptogram: "", error_message: "GPO failed" }
    val rec_resp = _simulate_apdu(read_record(1, 1))
    val ac_resp = _simulate_apdu(generate_ac(64, ""))
    return EmvResult {
        success: true,
        pan_token: "tok_emv_" + _int_to_text(txn.amount),
        auth_code: "AUTH" + _int_to_text(txn.unpredictable_number),
        aid: aid_str,
        app_label: "VISA DEBIT",
        cryptogram: ac_resp.data,
        error_message: ""
    }

fn _simulate_apdu(cmd: ApduCommand) -> ApduResponse:
    if cmd.ins == 164:
        return ApduResponse { sw1: 144, sw2: 0, data: "6F" }
    if cmd.ins == 168:
        return ApduResponse { sw1: 144, sw2: 0, data: "80" }
    if cmd.ins == 178:
        return ApduResponse { sw1: 144, sw2: 0, data: "70" }
    if cmd.ins == 174:
        return ApduResponse { sw1: 144, sw2: 0, data: "TC_CRYPTOGRAM_9F26" }
    if cmd.ins == 32:
        return ApduResponse { sw1: 144, sw2: 0, data: "" }
    return ApduResponse { sw1: 105, sw2: 0, data: "" }

fn _int_to_text(n: int) -> text:
    if n == 0: return "0"
    var result = ""
    var v = n
    if v < 0: v = 0 - v
    while v > 0:
        val d = v % 10
        val ch = if d == 0: "0" else if d == 1: "1" else if d == 2: "2" else if d == 3: "3" else if d == 4: "4" else if d == 5: "5" else if d == 6: "6" else if d == 7: "7" else if d == 8: "8" else: "9"
        result = ch + result
        v = v / 10
    if n < 0: result = "-" + result
    return result
